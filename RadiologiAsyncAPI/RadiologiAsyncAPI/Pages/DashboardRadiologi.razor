@page "/dashboard"
@using Microsoft.AspNetCore.Components.Forms
@using RadiologiAsyncAPI.Services
@using RadiologiAsyncAPI.Models
@inject AntreanService Antrean
@implements IDisposable

<div class="container mt-4">
    <div class="p-3 mb-4 bg-dark text-white rounded-3 shadow-sm">
        <h2 class="display-6 fw-bold">🏥 RSUD - SIM Radiologi AI</h2>
        <p class="col-md-8 fs-5 text-secondary">Sistem Pemrosesan Citra Medis Asinkron berbasis MedGemma 4B</p>
    </div>

    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">📤 Input Konsultasi Baru</h5>
                </div>
                <div class="card-body p-3">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nomor Rekam Medis (RM)</label>
                        <input type="text" @bind="pasienId" class="form-control form-control-lg" placeholder="Contoh: RM-2026-001" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Unggah Foto Chest X-Ray</label>
                        <InputFile OnChange="HandleFileSelected" class="form-control" accept="image/*" />
                    </div>
                    
                    <button class="btn btn-success btn-lg w-100 mt-2" @onclick="KirimKeSistemAI" disabled="@isProcessing">
                        @if (isProcessing) {
                            <span class="spinner-border spinner-border-sm" role="status"></span>
                            <span> Mengarsipkan...</span>
                        } else {
                            <span>⚡ Kirim ke Antrean AI</span>
                        }
                    </button>

                    @if (!string.IsNullOrEmpty(notifikasi)) {
                        <div class="alert alert-info mt-3 small">@notifikasi</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-secondary text-white py-3 d-flex justify-content-between align-middle">
                    <h5 class="card-title mb-0">⏳ Monitor Antrean & Hasil Analisis MedGemma</h5>
                    <span class="badge bg-light text-dark align-self-center">Live Auto-Refresh</span>
                </div>
                <div class="card-body p-0">
                    @if (listPasien == null || !listPasien.Any()) {
                        <div class="text-center py-5 text-muted">
                            <h5>Belum ada aktivitas antrean hari ini.</h5>
                            <p class="small">Silakan unggah data di panel kiri.</p>
                        </div>
                    } else {
                        <div class="table-responsive">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Tracking ID</th>
                                        <th>No. RM Pasien</th>
                                        <th>Status Pipa</th>
                                        <th style="width: 45%;">Interpretasi Diagnostik MedGemma</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var job in listPasien) {
                                        <tr>
                                            <td class="ps-3"><code>@job.TrackingId</code></td>
                                            <td class="fw-bold">@job.Data?.PasienId</td>
                                            <td>
                                                @if (job.Status == "Mengantre") {
                                                    <span class="badge bg-secondary p-2">⚪ Mengantre</span>
                                                } else if (job.Status == "Sedang Dianalisis") {
                                                    <span class="badge bg-warning text-dark p-2 animate-pulse">⏳ Proses AI</span>
                                                } else if (job.Status == "Selesai") {
                                                    <span class="badge bg-success p-2">🟢 Selesai</span>
                                                }
                                            </td>
                                            <td>
                                                @if (job.Status == "Selesai") {
                                                    <div class="p-2 bg-light border-start border-success border-3 rounded small text-dark">
                                                        @job.HasilAI
                                                    </div>
                                                } else {
                                                    <span class="text-muted italic small">@job.HasilAI</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string pasienId = "";
    private string base64Gambar = "";
    private string notifikasi = "";
    private bool isProcessing = false;
    private List<JobAntrean> listPasien = new();
    private System.Threading.Timer? periodicTimer;

    protected override void OnInitialized()
    {
        MuatDataAntrean();
        // Polling Otomatis: Menyuruh UI melakukan pengecekan data ke AntreanService setiap 2 detik secara real-time
        periodicTimer = new System.Threading.Timer(_ => {
            InvokeAsync(() => {
                MuatDataAntrean();
                StateHasChanged(); // Paksa layar untuk menggambar ulang komponen status warna
            });
        }, null, 0, 2000);
    }

    private void MuatDataAntrean()
    {
        listPasien = Antrean.TampilkanSemua();
        // Kita balik urutannya agar pasien terbaru muncul di paling atas tabel
        listPasien.Reverse(); 
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        using var stream = file.OpenReadStream(maxAllowedSize: 1024 * 1024 * 10); // Batas aman 10MB
        using var memoryStream = new MemoryStream();
        await stream.CopyToAsync(memoryStream);
        base64Gambar = Convert.ToBase64String(memoryStream.ToArray());
    }

    private async Task KirimKeSistemAI()
    {
        if (string.IsNullOrWhiteSpace(pasienId) || string.IsNullOrWhiteSpace(base64Gambar)) {
            notifikasi = "⚠️ Validasi Gagal: Nomor RM dan File rontgen wajib diisi!";
            return;
        }

        isProcessing = true;
        notifikasi = "Memasukkan ke pipa antrean...";

        string IDPelacak = Guid.NewGuid().ToString().Substring(0, 8).ToUpper();
        
        var jobBaru = new JobAntrean {
            TrackingId = IDPelacak,
            Data = new PermintaanXRay { PasienId = pasienId, Base64Image = base64Gambar }
        };

        // Menembak langsung ke internal Service tanpa mematikan UI
        await Antrean.TambahAsync(jobBaru);

        notifikasi = $"✅ Sukses! Pasien {pasienId} masuk antrean (ID: {IDPelacak}).";
        pasienId = ""; // Kosongkan form input
        base64Gambar = "";
        
        MuatDataAntrean();
        isProcessing = false;
    }

    public void Dispose()
    {
        periodicTimer?.Dispose(); // Hancurkan timer saat pindah halaman agar memori laptop hemat
    }
}